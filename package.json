{
  "name": "overton-portfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "build:local": "prisma generate && next build",
    "preview:library": "node scripts/preview-library.mjs",
    "admin:local": "node scripts/preview-library.mjs --office",
    "test:browser": "playwright test",
    "test:books": "playwright test tests/browser/books.spec.ts",
    "portrait:live-server": "node scripts/portrait-live-server.mjs",
    "eval:portrait": "node scripts/eval-portrait.mjs",
    "qualify:portrait": "node scripts/qualify-portrait-live.mjs && npx tsx scripts/qualify-portrait-failure.mts && node scripts/qualify-portrait-browser.mjs",
    "qualify:portrait-voice": "node scripts/qualify-portrait-voice.mjs",
    "portrait:ledger": "node scripts/reconcile-portrait-ledger.mjs --list",
    "test:navigation": "playwright test tests/browser/navigation.spec.ts",
    "test:admin": "node scripts/test-library-admin.mjs",
    "test:office": "node scripts/test-library-admin.mjs --office",
    "draft:review": "node scripts/review-library-draft.mjs",
    "test": "tsx --test tests/library.test.ts tests/estate.test.ts tests/kit.test.ts tests/portrait.test.ts tests/reports.test.ts tests/journey.test.ts tests/world-environment.test.ts tests/readiness.test.ts tests/leaf-surfaces.test.ts tests/portfolio.test.ts tests/release-paths.test.ts",
    "kit:pack": "node scripts/pack-kit.mjs",
    "kit:room": "node scripts/export-room.mjs",
    "estate:look": "node scripts/look-estate.mjs",
    "profile:library": "node scripts/profile-library.mjs",
    "test:portfolio": "tsx --test tests/portfolio.test.ts && playwright test --config tests/portfolio.config.ts",
    "test:safety": "node --test tests/release-safety.test.mjs",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run test:safety && npm run assets:inventory && npm run build:local",
    "assets:inventory": "node scripts/release-asset-inventory.mjs",
    "docs:build": "node scripts/schema-reference.mjs && node scripts/docs.mjs build",
    "docs:check": "node scripts/docs.mjs check",
    "docs:search": "node scripts/docs.mjs search",
    "docs:context": "node scripts/docs.mjs context",
    "docs:test": "node --test tests/docs/*.test.mjs .agent-docs/retrieval.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-three/fiber": "9.8.2",
    "@vercel/blob": "^2.8.1",
    "gray-matter": "^4.0.3",
    "next": "~16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "0.187.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.4.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "prisma": "^7.10.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
