# Files the Vercel CLI must not upload when deploying from this folder.
# Secrets: production reads its env vars from Vercel project settings.
.env
.env.*
!.env.example

# Local build output and tooling
/.next
/.next-office
/node_modules
/test-results
/playwright-report
/.local-library
*.tsbuildinfo

# Private notes and video masters (see .gitignore)
/content/projects
/content/media-src
/content/media-out

# Raw game film and local analysis work files; the site serves public/performances/
/public/*.mp4
/public/*.mov
/public/*.MOV
/public/library/artwork/proof-*.webp
/game_720p.mp4
/analysis.html
/clips
/thumbs

# Authoring masters and local-only evidence; runtime JSON/manifests stay included.
/.next-browser
/.firecrawl
/.git
/docs/travellers-rest-review
/docs/library-world-concepts
/assets/**/*.blend
/assets/**/*.blend1
/assets/**/*.tif
/assets/**/*.tiff
/assets/**/*.png
/assets/**/*.jpg
/assets/**/*.jpeg
/assets/**/*.mp4
/assets/**/*.pdf
/assets/**/*.wav
/assets/**/*.glb
