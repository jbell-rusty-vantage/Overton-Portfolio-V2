# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-office/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/lib/generated
!.env.example

/.local-library/
/test-results/
/playwright-report/

# Game film: raw exports dropped in public/ and local analysis work files (too large for git).
# The compressed clips the site serves live in public/performances/ and are committed.
/public/*.mp4
/game_720p.mp4
/analysis.html
/clips/
/thumbs/

# Private research notes, capture originals and unpublished video masters (never ship)
/content/projects/
/content/media-src/
/content/media-out/

# Game film: raw exports and full-match working copies are too large for git.
# The site serves the compressed clips under /public/performances/ (committed).
/public/*.mp4
/public/*.mov
/public/*.MOV
/game_720p.mp4
/clips/
/thumbs/
/analysis.html
