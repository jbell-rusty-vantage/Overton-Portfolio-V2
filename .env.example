# Copy to .env.local for local development. Never commit real values.

# Neon Postgres. Runtime uses the pooled URL; migrations derive the direct host automatically
# (scripts/db-deploy.mjs strips "-pooler"), or set DATABASE_URL_UNPOOLED explicitly.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob. On Vercel these come from the connected store (OIDC auth: BLOB_STORE_ID + VERCEL_OIDC_TOKEN).
# Locally, either `vercel env pull` (gets a short-lived VERCEL_OIDC_TOKEN) or set a read-write token.
# BLOB_STORE_ID="store_..."
# BLOB_WEBHOOK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: GitHub token for repo sync (raises rate limits; needed to list private repos).
# GITHUB_TOKEN="github_pat_..."

# Build-time migration controls (scripts/db-deploy.mjs)
# DB_DEPLOY_SKIP=1                 # skip migrations for this build
# RELEASE_DATABASE_FINGERPRINT= # required on Vercel and audited release writes; see scripts/database-target.mjs

# Canonical origin and database-only hosted content (no loopback office flags in Vercel)
# LIBRARY_PUBLIC_ORIGIN=https://overton-portfolio-v2.vercel.app
# LIBRARY_CONTENT_SOURCE=database

# Portrait: server-only configuration. Missing live settings selects reviewed excerpts.
# PORTRAIT_SESSION_SECRET=
# AI_GATEWAY_API_KEY=
# PORTRAIT_PAID_ENABLED=
# PORTRAIT_KILL_SWITCH=
# PORTRAIT_MODEL=
# PORTRAIT_PRICE_VERSION=
# PORTRAIT_INPUT_USD_PER_MILLION=
# PORTRAIT_OUTPUT_USD_PER_MILLION=
# PORTRAIT_WEB_SEARCH_USD_PER_CALL=
# PORTRAIT_USD_PER_TURN=0.05
# PORTRAIT_USD_PER_DAY=1
# PORTRAIT_USD_PER_MONTH=5
# PORTRAIT_NETWORK_DAY=30
# PORTRAIT_VOICE_ENABLED= # enable only after independently enforced gateway budgets
# PORTRAIT_VOICE_MODEL=
# PORTRAIT_VOICE_PRICE_VERSION=
# PORTRAIT_VOICE_USD_PER_MINUTE=
# PORTRAIT_VOICE_MAX_SECONDS=180
# PORTRAIT_VOICE_NAME=cedar
